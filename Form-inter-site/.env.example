# Copier en .env et renseigner. Voir README.md pour le détail.

# --- Base du site -----------------------------------------------------------
# Facultatif : sans cette variable, le site ET la CLI Prisma retombent tous
# deux sur `file:./dev.db`, relatif au dossier Form-inter-site. La valeur est
# résolue à un seul endroit (src/lib/database-url.ts) pour qu'ils ne puissent
# pas viser deux fichiers différents.
DATABASE_URL="file:./dev.db"

# Clé de signature du cookie d'administration (obligatoire).
# Laissée vide, `npm run dev` en tire une au sort et l'écrit ici même. Une clé
# déjà renseignée n'est jamais remplacée. En production, la fournir soi-même :
# openssl rand -hex 32
SESSION_SECRET=""

# --- Compte admin initial (utilisé par `npm run db:seed`) -------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD_SEED=""

# --- Synchronisation planifiée ----------------------------------------------
# Jeton attendu par /api/cron/sync. Laissé vide, l'endpoint reste fermé (503).
CRON_SECRET=""

# Cookie d'administration marqué Secure. Détecté automatiquement quand la
# requête arrive en HTTPS (X-Forwarded-Proto) : à ne forcer à 1 que derrière un
# reverse proxy TLS qui ne pose pas cet en-tête. En HTTP sur le LAN, laisser
# vide — un cookie Secure y est refusé par le navigateur et la connexion échoue
# en boucle, sans message.
COOKIE_SECURE=""

# --- Liaison avec le backend de veille --------------------------------------
# Valeurs de départ : ce qui est enregistré depuis /admin/sources l'emporte.

# off | http | sqlite
BACKEND_MODE="off"

# Mode "http" : le backend expose son catalogue en JSON (webapp/api.py).
BACKEND_URL="http://localhost:8000"
BACKEND_TOKEN=""

# Mode "sqlite" : lecture seule du fichier du backend, sur le même volume.
BACKEND_DB_PATH="../data/formations.db"

# Rafraîchissement automatique à la visite du site.
BACKEND_AUTO_SYNC="1"
BACKEND_SYNC_TTL_MINUTES="60"

# Rapatrier aussi les sessions déjà terminées.
BACKEND_INCLURE_PASSEES="0"

# --- OpenStreetMap ----------------------------------------------------------
# Le site géocode les adresses (centres de formation, adresse du client) et
# affiche une carte. Tout est mis en cache : une adresse déjà résolue ne
# repart jamais sur le réseau. Voir README, « OpenStreetMap ».

# User-Agent envoyé à Nominatim. Sa politique d'usage EXIGE qu'il identifie
# l'application et permette de la joindre ; les requêtes anonymes se font
# bloquer. À défaut, une valeur par défaut est construite avec NOMINATIM_CONTACT.
NOMINATIM_USER_AGENT=""
NOMINATIM_CONTACT=""

# Instance de géocodage. Par défaut celle d'OpenStreetMap, limitée à une
# requête par seconde. À remplacer par une instance auto-hébergée si le volume
# le justifie un jour.
NOMINATIM_URL="https://nominatim.openstreetmap.org"

# Pays auquel restreindre la recherche d'adresses (code ISO, vide = aucun).
NOMINATIM_PAYS="fr"

# Fond de carte. Celui d'OSM tolère un usage modeste ; pour un trafic plus
# élevé, pointer vers un fournisseur de tuiles dédié.
NEXT_PUBLIC_TUILES_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_TUILES_ATTRIBUTION=""
