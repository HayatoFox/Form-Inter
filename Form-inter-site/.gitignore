# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database
/dev.db
/prisma/dev.db
# Compagnons du mode WAL (voir src/lib/sqlite-reglages.ts) : SQLite les crée à
# côté de la base et les efface à la fermeture propre. Ils n'ont rien à faire
# dans le dépôt, et sans ces lignes ils apparaissent à chaque `git status`.
/dev.db-wal
/dev.db-shm
/prisma/dev.db-wal
/prisma/dev.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
