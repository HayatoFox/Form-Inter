# Variables du déploiement Docker (docker-compose.yml).
#
# En temps normal ce fichier n'a pas à être copié : `./deploy.sh` crée un .env
# et y engendre les mots de passe et jetons au premier lancement. Il sert de
# référence de ce qui est réglable.

TZ=Europe/Paris

# --- Collecte ---------------------------------------------------------------
CRON_SCHEDULE=0 6 * * *
# 0 pour ne pas scraper au démarrage du conteneur
SCRAPE_AT_STARTUP=1

# --- Site interne de veille (webapp Python, port 8000) ----------------------
WEBAPP_PORT=8000
WEBAPP_ADMIN_USER=admin
WEBAPP_ADMIN_PASSWORD=
# Jeton de l'API JSON lue par le site. Vide = API fermée (503).
WEBAPP_API_TOKEN=

# --- Site de consultation (Next.js, port 3000) ------------------------------
SITE_PORT=3000
SITE_ADMIN_EMAIL=admin@example.com
SITE_ADMIN_PASSWORD=
# Clé de signature du cookie d'administration du site.
SESSION_SECRET=
# Jeton de /api/cron/sync. Vide = endpoint fermé (503).
CRON_SECRET=

# --- Liaison site <- backend ------------------------------------------------
# http   : les deux conteneurs se parlent par le réseau du compose (défaut).
# sqlite : le site lit ../data/formations.db — décommenter alors le montage
#          de ./data sur le service `site` dans docker-compose.yml.
# off    : le site ne vit que de ses imports Excel/CSV.
BACKEND_MODE=http
BACKEND_AUTO_SYNC=1
BACKEND_SYNC_TTL_MINUTES=60
BACKEND_INCLURE_PASSEES=0
